<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:x="urn:schemas-microsoft-com:office:excel">
 <Styles>
  <Style ss:ID="Header"><Font ss:Bold="1" ss:Color="#FFFFFF"/><Interior ss:Color="#1E4E7E" ss:Pattern="Solid"/></Style>
  <Style ss:ID="Wrap"><Alignment ss:WrapText="1" ss:Vertical="Top"/></Style>
 </Styles>
 <Worksheet ss:Name="测试用例">
  <Table><Column ss:Width="10"/><Column ss:Width="12"/><Column ss:Width="22"/><Column ss:Width="26"/><Column ss:Width="40"/><Column ss:Width="34"/><Column ss:Width="8"/><Column ss:Width="10"/><Column ss:Width="10"/><Column ss:Width="24"/>
  <Row><Cell><Data ss:Type="String">用例编号</Data></Cell><Cell><Data ss:Type="String">功能模块</Data></Cell><Cell><Data ss:Type="String">测试点</Data></Cell><Cell><Data ss:Type="String">前置条件</Data></Cell><Cell><Data ss:Type="String">测试步骤</Data></Cell><Cell><Data ss:Type="String">预期结果</Data></Cell><Cell><Data ss:Type="String">优先级</Data></Cell><Cell><Data ss:Type="String">类型</Data></Cell><Cell><Data ss:Type="String">状态</Data></Cell><Cell><Data ss:Type="String">关联缺陷/备注</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-001</Data></Cell><Cell><Data ss:Type="String">认证</Data></Cell><Cell><Data ss:Type="String">管理员登录成功</Data></Cell><Cell><Data ss:Type="String">服务已启动</Data></Cell><Cell><Data ss:Type="String">POST /api/v1/auth/login {username:admin,password:admin123}</Data></Cell><Cell><Data ss:Type="String">返回 code=0，data 含 token，role=admin</Data></Cell><Cell><Data ss:Type="String">P0</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String">基准冒烟</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-002</Data></Cell><Cell><Data ss:Type="String">认证</Data></Cell><Cell><Data ss:Type="String">错误密码登录失败</Data></Cell><Cell><Data ss:Type="String">无</Data></Cell><Cell><Data ss:Type="String">POST /api/v1/auth/login 错误密码</Data></Cell><Cell><Data ss:Type="String">返回 401，未签发 token</Data></Cell><Cell><Data ss:Type="String">P0</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-003</Data></Cell><Cell><Data ss:Type="String">认证</Data></Cell><Cell><Data ss:Type="String">缺 token 访问受保护接口</Data></Cell><Cell><Data ss:Type="String">无</Data></Cell><Cell><Data ss:Type="String">GET /api/v1/devices 不带 Authorization</Data></Cell><Cell><Data ss:Type="String">返回 401「未认证或 token 失效」</Data></Cell><Cell><Data ss:Type="String">P0</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String">JwtAuthGuard</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-004</Data></Cell><Cell><Data ss:Type="String">认证</Data></Cell><Cell><Data ss:Type="String">无效/过期 token</Data></Cell><Cell><Data ss:Type="String">已登录</Data></Cell><Cell><Data ss:Type="String">携带伪造 token 访问接口</Data></Cell><Cell><Data ss:Type="String">返回 401，不泄露数据</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String">JwtAuthGuard.handleRequest</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-010</Data></Cell><Cell><Data ss:Type="String">权限</Data></Cell><Cell><Data ss:Type="String">viewer 禁止新建用户</Data></Cell><Cell><Data ss:Type="String">存在 viewer 角色令牌</Data></Cell><Cell><Data ss:Type="String">viewer 令牌 POST /api/v1/users {role:admin}</Data></Cell><Cell><Data ss:Type="String">返回 403「权限不足」</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B1 @Roles(admin)</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-011</Data></Cell><Cell><Data ss:Type="String">权限</Data></Cell><Cell><Data ss:Type="String">viewer 禁止自提权</Data></Cell><Cell><Data ss:Type="String">viewer 令牌</Data></Cell><Cell><Data ss:Type="String">viewer PUT /api/v1/users/:selfId {role:admin}</Data></Cell><Cell><Data ss:Type="String">返回 403，角色不被提升</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B1 防垂直越权</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-012</Data></Cell><Cell><Data ss:Type="String">权限</Data></Cell><Cell><Data ss:Type="String">viewer 禁止删除用户</Data></Cell><Cell><Data ss:Type="String">viewer 令牌</Data></Cell><Cell><Data ss:Type="String">viewer DELETE /api/v1/users/:id</Data></Cell><Cell><Data ss:Type="String">返回 403</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B1</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-013</Data></Cell><Cell><Data ss:Type="String">权限</Data></Cell><Cell><Data ss:Type="String">viewer 禁止新建角色</Data></Cell><Cell><Data ss:Type="String">viewer 令牌</Data></Cell><Cell><Data ss:Type="String">viewer POST /api/v1/roles</Data></Cell><Cell><Data ss:Type="String">返回 403</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B1</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-014</Data></Cell><Cell><Data ss:Type="String">权限</Data></Cell><Cell><Data ss:Type="String">viewer 禁止保存地图配置</Data></Cell><Cell><Data ss:Type="String">viewer 令牌</Data></Cell><Cell><Data ss:Type="String">viewer PUT /api/v1/gis/config</Data></Cell><Cell><Data ss:Type="String">返回 403</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B1</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-015</Data></Cell><Cell><Data ss:Type="String">权限</Data></Cell><Cell><Data ss:Type="String">viewer 禁止保存大屏样式</Data></Cell><Cell><Data ss:Type="String">viewer 令牌</Data></Cell><Cell><Data ss:Type="String">viewer PUT /api/v1/bigscreen/config</Data></Cell><Cell><Data ss:Type="String">返回 403</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B1</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-016</Data></Cell><Cell><Data ss:Type="String">权限</Data></Cell><Cell><Data ss:Type="String">viewer 禁止新增/删除设备</Data></Cell><Cell><Data ss:Type="String">viewer 令牌</Data></Cell><Cell><Data ss:Type="String">viewer POST/DELETE /api/v1/devices</Data></Cell><Cell><Data ss:Type="String">返回 403</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B1</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-017</Data></Cell><Cell><Data ss:Type="String">权限</Data></Cell><Cell><Data ss:Type="String">viewer 禁止删除楼栋</Data></Cell><Cell><Data ss:Type="String">viewer 令牌</Data></Cell><Cell><Data ss:Type="String">viewer DELETE /api/v1/buildings/:id</Data></Cell><Cell><Data ss:Type="String">返回 403</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B1</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-018</Data></Cell><Cell><Data ss:Type="String">权限</Data></Cell><Cell><Data ss:Type="String">viewer 禁止场景写接口</Data></Cell><Cell><Data ss:Type="String">viewer 令牌</Data></Cell><Cell><Data ss:Type="String">viewer PUT /api/v1/scene/subsystem-meta 等</Data></Cell><Cell><Data ss:Type="String">返回 403</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B1</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-019</Data></Cell><Cell><Data ss:Type="String">权限</Data></Cell><Cell><Data ss:Type="String">admin 可执行全部写接口</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">admin 调用上述所有写接口</Data></Cell><Cell><Data ss:Type="String">均返回 2xx 成功</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B1</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-020</Data></Cell><Cell><Data ss:Type="String">权限</Data></Cell><Cell><Data ss:Type="String">viewer 可读接口正常开放</Data></Cell><Cell><Data ss:Type="String">viewer 令牌</Data></Cell><Cell><Data ss:Type="String">viewer GET /api/v1/devices、/buildings、/bigscreen/layout</Data></Cell><Cell><Data ss:Type="String">返回 2xx 数据</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String">未标注@Roles则放行</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-030</Data></Cell><Cell><Data ss:Type="String">设备管理</Data></Cell><Cell><Data ss:Type="String">设备分页查询</Data></Cell><Cell><Data ss:Type="String">已登录</Data></Cell><Cell><Data ss:Type="String">GET /api/v1/devices?page=1&amp;limit=20</Data></Cell><Cell><Data ss:Type="String">返回 {items,total,page,limit}，分页正确</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String">limit 上限 1000</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-031</Data></Cell><Cell><Data ss:Type="String">设备管理</Data></Cell><Cell><Data ss:Type="String">按楼栋过滤</Data></Cell><Cell><Data ss:Type="String">已登录</Data></Cell><Cell><Data ss:Type="String">GET /api/v1/devices?building_id=1</Data></Cell><Cell><Data ss:Type="String">仅返回 1 号楼设备</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String">前端传 building_id</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-032</Data></Cell><Cell><Data ss:Type="String">设备管理</Data></Cell><Cell><Data ss:Type="String">按 code 过滤（B8 修复）</Data></Cell><Cell><Data ss:Type="String">已登录</Data></Cell><Cell><Data ss:Type="String">GET /api/v1/devices?code=B1-SCREW_CHILLER-001</Data></Cell><Cell><Data ss:Type="String">精确返回该设备；修复前该参数被白名单剥离导致全量返回</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B8 补 code 字段</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-033</Data></Cell><Cell><Data ss:Type="String">设备管理</Data></Cell><Cell><Data ss:Type="String">创建设备缺 building_id（B2 修复）</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">POST /api/v1/devices {} 不传 building_id</Data></Cell><Cell><Data ss:Type="String">返回 400「building_id 必填」；修复前静默在 1 号楼建孤儿设备</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B2 显式校验</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-034</Data></Cell><Cell><Data ss:Type="String">设备管理</Data></Cell><Cell><Data ss:Type="String">创建设备到不存在楼栋</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">POST /api/v1/devices {building_id:999}</Data></Cell><Cell><Data ss:Type="String">返回 400「楼栋不存在」</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">边界</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B2</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-035</Data></Cell><Cell><Data ss:Type="String">设备管理</Data></Cell><Cell><Data ss:Type="String">删除设备</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">DELETE /api/v1/devices/:id</Data></Cell><Cell><Data ss:Type="String">返回成功，设备从列表消失（重启不回现）</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String">mock deleted 机制</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-036</Data></Cell><Cell><Data ss:Type="String">设备管理</Data></Cell><Cell><Data ss:Type="String">设备控制下发</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">POST /api/v1/devices/:id/control</Data></Cell><Cell><Data ss:Type="String">返回控制回执</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-040</Data></Cell><Cell><Data ss:Type="String">地图配置</Data></Cell><Cell><Data ss:Type="String">viewer 不泄露地图 Key（B4 修复）</Data></Cell><Cell><Data ss:Type="String">viewer 令牌</Data></Cell><Cell><Data ss:Type="String">GET /api/v1/gis/config</Data></Cell><Cell><Data ss:Type="String">返回不含 tiandituKey/gaodeKey 等字段（仅 provider/baseLayer/showLabel/center）</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B4 角色分支 getPublicConfig</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-041</Data></Cell><Cell><Data ss:Type="String">地图配置</Data></Cell><Cell><Data ss:Type="String">admin 可见完整配置</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">GET /api/v1/gis/config</Data></Cell><Cell><Data ss:Type="String">返回含全部 Key 字段</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B4</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-042</Data></Cell><Cell><Data ss:Type="String">地图配置</Data></Cell><Cell><Data ss:Type="String">瓦片代理不暴露 Key</Data></Cell><Cell><Data ss:Type="String">无</Data></Cell><Cell><Data ss:Type="String">GET /api/v1/gis/tile-proxy?...</Data></Cell><Cell><Data ss:Type="String">返回瓦片二进制，Key 仅服务端拼接</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String">合规：前端绝不接触原始 Key</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-043</Data></Cell><Cell><Data ss:Type="String">地图配置</Data></Cell><Cell><Data ss:Type="String">瓦片参数非法校验</Data></Cell><Cell><Data ss:Type="String">无</Data></Cell><Cell><Data ss:Type="String">tile-proxy?z=99</Data></Cell><Cell><Data ss:Type="String">返回 400 参数非法</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">边界</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-050</Data></Cell><Cell><Data ss:Type="String">大屏布局</Data></Cell><Cell><Data ss:Type="String">布局读取合并默认</Data></Cell><Cell><Data ss:Type="String">已登录</Data></Cell><Cell><Data ss:Type="String">GET /api/v1/bigscreen/layout?system=overview</Data></Cell><Cell><Data ss:Type="String">返回 17 框 x/y/w/h/frame（含 innerBorderColor 透传）</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String">Fix B 透传</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-051</Data></Cell><Cell><Data ss:Type="String">大屏布局</Data></Cell><Cell><Data ss:Type="String">布局保存 round-trip</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">PUT /api/v1/bigscreen/layout 改 innerBorderColor 后 GET 校验</Data></Cell><Cell><Data ss:Type="String">GET 持久化该颜色（重启后仍保留）</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">回归</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">Fix B 后端 round-trip</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-052</Data></Cell><Cell><Data ss:Type="String">大屏样式</Data></Cell><Cell><Data ss:Type="String">样式读取</Data></Cell><Cell><Data ss:Type="String">已登录</Data></Cell><Cell><Data ss:Type="String">GET /api/v1/bigscreen/config?system=overview</Data></Cell><Cell><Data ss:Type="String">返回合并默认样式（accent/bg/panelAlpha/radius 等）</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-053</Data></Cell><Cell><Data ss:Type="String">大屏样式</Data></Cell><Cell><Data ss:Type="String">圆角滑块生效（Fix D）</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">后台改 radius 保存，大屏查看</Data></Cell><Cell><Data ss:Type="String">圆角随 radius 变化；左/右/底栏宽滑块已移除（参考页无此容器）</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">UI</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">Fix D 删死控件</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-054</Data></Cell><Cell><Data ss:Type="String">大屏</Data></Cell><Cell><Data ss:Type="String">重置样式为默认（B7 修复）</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">DELETE /api/v1/bigscreen/config?system=overview</Data></Cell><Cell><Data ss:Type="String">返回默认样式，已保存项被清除</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B7 新增 DELETE</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-055</Data></Cell><Cell><Data ss:Type="String">大屏</Data></Cell><Cell><Data ss:Type="String">重置布局为默认（B7 修复）</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">DELETE /api/v1/bigscreen/layout?system=overview</Data></Cell><Cell><Data ss:Type="String">返回默认 17 框布局</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B7 新增 DELETE</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-060</Data></Cell><Cell><Data ss:Type="String">3D场景</Data></Cell><Cell><Data ss:Type="String">场景配置加载</Data></Cell><Cell><Data ss:Type="String">已登录</Data></Cell><Cell><Data ss:Type="String">GET /api/v1/scene/config</Data></Cell><Cell><Data ss:Type="String">返回模型 URL/楼栋锚点</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-061</Data></Cell><Cell><Data ss:Type="String">3D场景</Data></Cell><Cell><Data ss:Type="String">楼栋位置 DIY 优先 anchor（Fix C）</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">改 building_anchors 后刷新 3D</Data></Cell><Cell><Data ss:Type="String">楼栋按 anchor 定位，回退 position</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">回归</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">Fix C anchorOf 优先</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-062</Data></Cell><Cell><Data ss:Type="String">3D场景</Data></Cell><Cell><Data ss:Type="String">子系统名自定义生效（Fix A）</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">PUT /api/v1/scene/subsystem-meta 改名，看综合概述面板</Data></Cell><Cell><Data ss:Type="String">面板显示自定义名（metaOf 用 subsystemName）</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">回归</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">Fix A</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-063</Data></Cell><Cell><Data ss:Type="String">3D场景</Data></Cell><Cell><Data ss:Type="String">HUD 框内描边色透传（Fix E）</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">schema hud 设 innerBorderColor 保存查看</Data></Cell><Cell><Data ss:Type="String">前端 PanelCard 应用该色</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">回归</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">Fix E hudWidgetToBox</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-064</Data></Cell><Cell><Data ss:Type="String">3D场景</Data></Cell><Cell><Data ss:Type="String">楼栋显示 DIY</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">PUT /api/v1/scene/building-display</Data></Cell><Cell><Data ss:Type="String">楼栋区域/背景透明度更新</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-065</Data></Cell><Cell><Data ss:Type="String">3D场景</Data></Cell><Cell><Data ss:Type="String">3D 标记 CRUD</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">POST/PUT/DELETE /api/v1/scene/markers</Data></Cell><Cell><Data ss:Type="String">标记增删改生效</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String">B1 已加 admin 守卫</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-070</Data></Cell><Cell><Data ss:Type="String">数据完整性</Data></Cell><Cell><Data ss:Type="String">1号楼种子设备恢复</Data></Cell><Cell><Data ss:Type="String">线上 runtime.json 误删</Data></Cell><Cell><Data ss:Type="String">恢复 deleted 中 20 台 HVAC 种子并重启</Data></Cell><Cell><Data ss:Type="String">GET /devices 1 号楼=139 台，螺杆机 001+002 均在</Data></Cell><Cell><Data ss:Type="String">P0</Data></Cell><Cell><Data ss:Type="String">回归</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">QA误删事故恢复</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-071</Data></Cell><Cell><Data ss:Type="String">数据完整性</Data></Cell><Cell><Data ss:Type="String">junk 测试设备清理</Data></Cell><Cell><Data ss:Type="String">恢复后</Data></Cell><Cell><Data ss:Type="String">核查 devices.data</Data></Cell><Cell><Data ss:Type="String">无 dev-msx*/dev-mtuy* 等测试设备残留</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">回归</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">清理2条junk+幽灵deleted</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-080</Data></Cell><Cell><Data ss:Type="String">全局</Data></Cell><Cell><Data ss:Type="String">未知 system 参数</Data></Cell><Cell><Data ss:Type="String">已登录</Data></Cell><Cell><Data ss:Type="String">GET /api/v1/bigscreen/layout?system=xxx</Data></Cell><Cell><Data ss:Type="String">回落默认或空，不 500</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">边界</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-081</Data></Cell><Cell><Data ss:Type="String">全局</Data></Cell><Cell><Data ss:Type="String">空 body 写接口不再 400（前端 B3/Fix A）</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">前端 apiDelete 在无 data 时移除 Content-Type；DELETE /devices/:id 不带 body 头</Data></Cell><Cell><Data ss:Type="String">后端按空体处理返回 2xx/404（修复前 Fastify 抛 400）；后端严禁注册同名 application/json parser 以免启动崩溃</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">边界</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">Fix A 前端修复+启动避坑</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-082</Data></Cell><Cell><Data ss:Type="String">全局</Data></Cell><Cell><Data ss:Type="String">未知路由</Data></Cell><Cell><Data ss:Type="String">无</Data></Cell><Cell><Data ss:Type="String">GET /api/v1/nonexist</Data></Cell><Cell><Data ss:Type="String">返回 404 统一包装</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">边界</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-090</Data></Cell><Cell><Data ss:Type="String">能源</Data></Cell><Cell><Data ss:Type="String">能耗趋势查询</Data></Cell><Cell><Data ss:Type="String">已登录</Data></Cell><Cell><Data ss:Type="String">GET /api/v1/energy/trend</Data></Cell><Cell><Data ss:Type="String">返回趋势数据</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">待回归</Data></Cell><Cell><Data ss:Type="String">前端QA覆盖</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-091</Data></Cell><Cell><Data ss:Type="String">告警</Data></Cell><Cell><Data ss:Type="String">告警列表</Data></Cell><Cell><Data ss:Type="String">已登录</Data></Cell><Cell><Data ss:Type="String">GET /api/v1/alarms</Data></Cell><Cell><Data ss:Type="String">返回活跃告警</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">待回归</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-092</Data></Cell><Cell><Data ss:Type="String">告警</Data></Cell><Cell><Data ss:Type="String">告警确认/清除</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">POST /api/v1/alarms/:id/ack|clear 空 body</Data></Cell><Cell><Data ss:Type="String">返回成功（B3 空 body 不再 400）</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">B3</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-093</Data></Cell><Cell><Data ss:Type="String">工单</Data></Cell><Cell><Data ss:Type="String">工单列表/分页</Data></Cell><Cell><Data ss:Type="String">已登录</Data></Cell><Cell><Data ss:Type="String">GET /api/v1/work-orders</Data></Cell><Cell><Data ss:Type="String">返回分页工单</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">待回归</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-100</Data></Cell><Cell><Data ss:Type="String">前端-安全</Data></Cell><Cell><Data ss:Type="String">403 统一友好提示（FE-001）</Data></Cell><Cell><Data ss:Type="String">非 admin 令牌</Data></Cell><Cell><Data ss:Type="String">触发任一 @Roles(admin) 写接口（如 PUT /bigscreen/config）</Data></Cell><Cell><Data ss:Type="String">拦截器返回「权限不足，请联系管理员或使用 admin 账号操作」，不抛出原始异常、不误登出</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">request.ts 响应拦截器增 403 分支</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-101</Data></Cell><Cell><Data ss:Type="String">前端-权限</Data></Cell><Cell><Data ss:Type="String">canControl 移除不存在的 operator 角色（FE-002）</Data></Cell><Cell><Data ss:Type="String">源码审计</Data></Cell><Cell><Data ss:Type="String">审查 stores/user.ts canControl()</Data></Cell><Cell><Data ss:Type="String">不再引用后端角色集（admin/maintainer/duty/leader/viewer）之外的 operator；与后端 @Roles(admin) 对齐</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">死角色引用导致越权误判</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-102</Data></Cell><Cell><Data ss:Type="String">前端-UI</Data></Cell><Cell><Data ss:Type="String">审计页状态色改用令牌（FE-003）</Data></Cell><Cell><Data ss:Type="String">源码审计</Data></Cell><Cell><Data ss:Type="String">审查 AuditTrailAdmin.vue is-broken/is-warn/is-overdue</Data></Cell><Cell><Data ss:Type="String">由 #ff5b5b/#e6a23c 改为 var(--kp-danger)/var(--kp-warn)，无硬编码色</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">UI</Data></Cell><Cell><Data ss:Type="String">已修复</Data></Cell><Cell><Data ss:Type="String">设计令牌合规 P0 规则</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-103</Data></Cell><Cell><Data ss:Type="String">前端-架构</Data></Cell><Cell><Data ss:Type="String">ThreeViewer facade 合规（Area5）</Data></Cell><Cell><Data ss:Type="String">源码审计</Data></Cell><Cell><Data ss:Type="String">审查 components/three/ThreeViewer.vue</Data></Cell><Cell><Data ss:Type="String">仅做事件路由与 store 接线，渲染交 SceneRenderer、交互交 InteractionController；无内联渲染逻辑</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String">GK-04 拆分后 facade</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-104</Data></Cell><Cell><Data ss:Type="String">前端-UI</Data></Cell><Cell><Data ss:Type="String">后台页 admin 外壳一致（Area1）</Data></Cell><Cell><Data ss:Type="String">源码审计</Data></Cell><Cell><Data ss:Type="String">审查所有 admin 页根节点</Data></Cell><Cell><Data ss:Type="String">统一使用 .admin-page/.admin-toolbar/.kp-panel/.kp-corner/.kp-panel-title 三件套</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">UI</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-105</Data></Cell><Cell><Data ss:Type="String">前端-大屏</Data></Cell><Cell><Data ss:Type="String">大屏 DIY 保存 round-trip（Area3）</Data></Cell><Cell><Data ss:Type="String">admin 令牌</Data></Cell><Cell><Data ss:Type="String">后台改样式/布局（含 title/titleSize/titleColor/borderColor）保存后 GET 校验</Data></Cell><Cell><Data ss:Type="String">GET 持久化且字段不丢失；部署后回归</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">回归</Data></Cell><Cell><Data ss:Type="String">待回归</Data></Cell><Cell><Data ss:Type="String">需部署后验证</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-106</Data></Cell><Cell><Data ss:Type="String">前端-同步</Data></Cell><Cell><Data ss:Type="String">跨标签实时同步 + 401 跳登录（Area6）</Data></Cell><Cell><Data ss:Type="String">多标签</Data></Cell><Cell><Data ss:Type="String">一标签改楼栋显示/子系统，另一标签 BroadcastChannel 收通知刷新</Data></Cell><Cell><Data ss:Type="String">store 经 kp-scene-model/kp-scene-building-display 同步；401 清除令牌并引导登录</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">功能</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String">stores/scene.ts、stores/bigscreen.ts</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-107</Data></Cell><Cell><Data ss:Type="String">前端-权限</Data></Cell><Cell><Data ss:Type="String">RBAC 菜单按权限过滤（Area7）</Data></Cell><Cell><Data ss:Type="String">非 admin 令牌</Data></Cell><Cell><Data ss:Type="String">以 viewer/leader 登录进入后台</Data></Cell><Cell><Data ss:Type="String">仅显示有权限菜单项，写接口按钮不可见；后端兜底 @Roles</Data></Cell><Cell><Data ss:Type="String">P1</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String">AdminLayout 按 permission 过滤</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-108</Data></Cell><Cell><Data ss:Type="String">前端-认证</Data></Cell><Cell><Data ss:Type="String">登录 JWT 写入与请求拦截</Data></Cell><Cell><Data ss:Type="String">未登录</Data></Cell><Cell><Data ss:Type="String">登录后检查 localStorage kp-auth-token 与请求头 Authorization</Data></Cell><Cell><Data ss:Type="String">token 持久化，axios 拦截器附加 Bearer</Data></Cell><Cell><Data ss:Type="String">P0</Data></Cell><Cell><Data ss:Type="String">安全</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String">lib/request.ts</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">TC-109</Data></Cell><Cell><Data ss:Type="String">前端-UI</Data></Cell><Cell><Data ss:Type="String">审计页打印白底不影响屏幕主题</Data></Cell><Cell><Data ss:Type="String">源码审计</Data></Cell><Cell><Data ss:Type="String">审查 AuditTrailAdmin.vue @media print</Data></Cell><Cell><Data ss:Type="String">#fff 背景仅作用于 @media print，屏幕态仍为深色主题</Data></Cell><Cell><Data ss:Type="String">P2</Data></Cell><Cell><Data ss:Type="String">UI</Data></Cell><Cell><Data ss:Type="String">通过</Data></Cell><Cell><Data ss:Type="String">非缺陷，确认</Data></Cell></Row>
  </Table>
 </Worksheet>
